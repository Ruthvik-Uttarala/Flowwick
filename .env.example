# Flowwick environment template
# Copy this file to `.env.local` for local development. Never commit real values.
# Production values belong in the selected hosting project's environment settings.

# -- Public browser configuration ---------------------------------------------
# Public values are embedded in browser code. They must never contain secrets.
NEXT_PUBLIC_SUPABASE_URL=https://project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=public-anon-key

# Local development may use http://localhost:3000. Production must use the
# canonical HTTPS origin only, with no path, query string, or fragment.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -- Server-only credentials --------------------------------------------------
# Never prefix these values with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=server-service-role-key
OPENAI_API_KEY=server-openai-api-key

# Shopify OAuth is required for merchant connection flows.
SHOPIFY_CLIENT_ID=shopify-client-id
SHOPIFY_CLIENT_SECRET=shopify-client-secret

# Optional legacy/local merchant fallback. Connected merchants store their own
# store domain and access token; this is not required by production validation.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_TOKEN=

# -- Instagram and Meta -------------------------------------------------------
# Instagram defaults to enabled. When enabled, all three server-only Meta values
# below are required. Set INSTAGRAM_ENABLED=false to disable the integration.
INSTAGRAM_ENABLED=true
META_APP_ID=meta-app-id
META_APP_SECRET=meta-app-secret
META_TOKEN_ENCRYPTION_KEY=meta-token-encryption-key

# Optional legacy per-merchant fallback credentials. OAuth-connected merchants
# store these values per merchant, so they are not global production requirements.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# Optional legacy debug flag retained for backward compatibility.
FLOWCART_ENABLE_INSTAGRAM_DEBUG_FIELDS=false
